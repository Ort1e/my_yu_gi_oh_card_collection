# The nightly job: backup, public copy and its upload, update of the app
# (nightly.sh). Started by collection-nightly.timer; by hand:
#   systemctl start collection-nightly
[Unit]
Description=Card and book collection (nightly: backup, public copy, update)
RequiresMountsFor=/apps /Data1To /Data500
# run at boot when a day was missed: the upload and the update need the network
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/apps/collection/deploy/nightly.sh
