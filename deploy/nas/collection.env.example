# The app's settings on the NAS (systemd's EnvironmentFile, read by the app
# and the scripts). Copied to /apps/collection/collection.env by install.sh:
# fill in the passwords there. Never commit the real file.
DATABASE_URL=sqlite:/Data1To/collection/app.db
MEDIA_DIR=/Data1To/collection/media
UPLOADS_DIR=/Data1To/collection/uploads
# the home network only: the box opens no port to the NAS
BIND_ADDR=0.0.0.0:3000
# every page behind the login (a guest on the Wi-Fi sees nothing)
PUBLIC_READS=0
# plain HTTP on the home network: the cookie can't be HTTPS-only
SECURE_COOKIES=0
# one password per person: the password says who logs in
APP_PASSWORD=
APP_PASSWORD_FRIEND=
# what the friend may change: the books only unless set (all, or a list:
# books,pokemon); they see everything
#APP_ACCESS_FRIEND=all
CARDMARKET_ACCOUNT=0rtie
RUST_LOG=info
