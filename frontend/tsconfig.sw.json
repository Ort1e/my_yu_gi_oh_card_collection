{
    // The live tournament page's service worker (static/js/live_sw.js): a
    // page script, but it runs in a worker, so it is checked with the
    // WebWorker library instead of the DOM's.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "WebWorker"],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "types": []
    },
    "include": ["../static/js/live_sw.js"]
}
