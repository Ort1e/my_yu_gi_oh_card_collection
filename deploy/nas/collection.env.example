# The app's settings on the NAS (systemd's EnvironmentFile, read by the app
# and the scripts). Copied to /apps/collection/collection.env by install.sh:
# fill in the passwords there. Never commit the real file.
DATABASE_URL=sqlite:/Data1To/collection/app.db
MEDIA_DIR=/Data1To/collection/media
UPLOADS_DIR=/Data1To/collection/uploads
# the home network only: the box opens no port to the NAS
BIND_ADDR=0.0.0.0:3000
# every page behind the login (a guest on the Wi-Fi sees nothing)
PUBLIC_READS=0
# plain HTTP on the home network: the cookie can't be HTTPS-only
SECURE_COOKIES=0
# Only for the FIRST start: they create the users (APP_PASSWORD: `admin`,
# who may change everything; APP_PASSWORD_<NAME>: `<name>`). After that the
# users, their passwords and permissions are managed in the app, at /users,
# and these are ignored.
APP_PASSWORD=
APP_PASSWORD_FRIEND=
# what the friend may change: the books only unless set (all, or a list:
# books,pokemon); they see everything
#APP_ACCESS_FRIEND=all
CARDMARKET_ACCOUNT=0rtie
# Google Books' API key for the ISBN lookups (free, 1000 a day: the app stops
# at 800); without one Google nearly always refuses (its keyless quota is
# shared by everyone)
GOOGLE_BOOKS_API_KEY=
# A Discord channel's webhook (Edit channel → Integrations → Webhooks → Copy
# webhook URL): the live tournament notes go there when the start page's
# switch is on. A secret: whoever has it can post in the channel.
DISCORD_WEBHOOK_URL=
# Where the public copy is online (https://<domain>/collection, see OVH_DIR in
# nightly.env): the Discord summary of a tournament links to its deck list there.
PUBLIC_SITE_URL=
RUST_LOG=info
