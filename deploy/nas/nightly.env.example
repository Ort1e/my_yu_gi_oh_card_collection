# The nightly job's settings and secrets (backups, public copy, updates):
# read by the scripts only, never by the app. Copied to
# /apps/collection/nightly.env by install.sh (readable by root only): fill
# it in there. Never commit the real file.

# where the nightly copies of the data go (the other volume: other disks)
BACKUP_DIR=/Data500/collection-backups
BACKUP_KEEP_DAYS=14

# the public copy, written then uploaded to the OVH hosting
EXPORT_DIR=/Data1To/collection/public-export
# ftp (plain, what the free plan accepts today) or sftp (once enabled in
# the OVH panel, FTP-SSH tab: the password then travels encrypted)
OVH_PROTOCOL=ftp
OVH_HOST=ftp.cluster129.hosting.ovh.net
OVH_USER=
OVH_PASSWORD=
# the hosting's folder for the site (the one the domain or subdomain shows)
OVH_DIR=www

# the app's updates: the release `nas-latest` of this repository, read
# with a fine-grained token limited to it, "Contents: read-only"
GITHUB_REPO=Ort1e/my_yu_gi_oh_card_collection
GITHUB_TOKEN=
